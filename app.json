{
  "expo": {
    "name": "Pical",
    "slug": "pical",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "picturecalender",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jiahleework.pical"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jiahleework.pical"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F5"
        }
      ],
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "사진을 불러오고 저장하려면 사진 보관함 접근 권한이 필요합니다.",
          "savePhotosPermission": "공유 이미지를 갤러리에 저장하려면 사진 저장 권한이 필요합니다."
        }
      ],
      "expo-sharing",
      "./plugins/with-reicon-menu-assets"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
