{
  "name": "picture-calendar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.2",
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/ui": "~57.0.19",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@gorhom/portal": "^1.0.14",
    "@quidone/react-native-wheel-picker": "^1.7.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-community/slider": "^5.2.0",
    "@storybook/addon-ondevice-actions": "^10.5.2",
    "@storybook/addon-ondevice-controls": "^10.5.2",
    "@storybook/react-native": "^10.5.2",
    "@storybook/react-native-ui-lite": "^10.5.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.21",
    "expo": "~57.0.24",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "i18n-js": "^4.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-image-crop-picker": "0.51.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "reicon-react-native": "^1.0.102",
    "storybook": "^10.5.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "scripts/run-android-dev-client.sh",
    "android:dev": "scripts/run-android-dev-client.sh",
    "android:no-bundler": "scripts/run-android-dev-client.sh --no-bundler",
    "ios": "scripts/run-ios-dev-client.sh",
    "ios:dev": "scripts/run-ios-dev-client.sh",
    "ios:no-bundler": "scripts/run-ios-dev-client.sh --no-bundler",
    "devices": "pnpm run ios:no-bundler & pnpm run android:no-bundler & wait",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:native-menu-icons": "node scripts/generate-reicon-menu-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/boundary-check.js",
    "storybook:start": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true scripts/run-ios-dev-client.sh",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true scripts/run-android-dev-client.sh",
    "storybook:visual": "maestro test .maestro/storybook-screenshots.yaml",
    "verify:logic": "pnpm run test && pnpm run typecheck",
    "verify:component": "pnpm run verify:logic && scripts/verify-storybook-ui.sh",
    "verify:e2e": "scripts/verify-e2e.sh",
    "verify:intent": "pnpm run verify:component && pnpm run verify:e2e"
  },
  "private": true
}
