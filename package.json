    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "scripts/run-android-dev-client.sh",
    "android:dev": "scripts/run-android-dev-client.sh",
    "android:no-bundler": "scripts/run-android-dev-client.sh --no-bundler",
    "ios": "scripts/run-ios-dev-client.sh",
    "ios:dev": "scripts/run-ios-dev-client.sh",
    "ios:no-bundler": "scripts/run-ios-dev-client.sh --no-bundler",
    "devices": "pnpm run ios:no-bundler & pnpm run android:no-bundler & wait",
    "web": "expo start --web",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/boundary-check.js",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:generate": "sb-rn-get-stories --config-path ./.rnstorybook",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true scripts/run-ios-dev-client.sh",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true scripts/run-android-dev-client.sh",
    "storybook:visual": "maestro test .maestro/storybook-screenshots.yaml"
  },
  "private": true
